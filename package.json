{
  "name": "jialan-toolbox",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "node --test tests/unit.test.js",
    "test:rules": "firebase emulators:exec --project demo-jialan --only firestore \"node --test tests/rules.test.js\"",
    "serve": "http-server -p 5500 -c-1 -s .",
    "emu": "firebase emulators:start --project demo-jialan --only auth,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.35.0",
    "http-server": "14.1.1"
  }
}
